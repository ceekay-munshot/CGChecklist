{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cgchecklist",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Caches MUNS model runs keyed by ticker/country so a run produced within the
  // last month is served from KV instead of re-running the model.
  // Create the namespace once and paste its id below:
  //   npx wrangler kv namespace create MUNS_RUNS
  "kv_namespaces": [
    {
      "binding": "MUNS_RUNS",
      "id": "<REPLACE_WITH_KV_NAMESPACE_ID>"
    }
  ],
  "build": {
    "command": "npx opennextjs-cloudflare build"
  },
  "observability": {
    "enabled": true
  }
}
