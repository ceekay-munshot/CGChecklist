{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cgchecklist",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-26",
  "compatibility_flags": ["nodejs_compat"],
  // Non-secret vars. GITHUB_REPO is the "owner/repo" the dashboard dispatches
  // the analyze.yml workflow against (see src/app/api/report/run/route.ts).
  // The matching secret GITHUB_DISPATCH_TOKEN (a PAT with Actions: write) is set
  // out of band: `npx wrangler secret put GITHUB_DISPATCH_TOKEN`.
  "vars": {
    "GITHUB_REPO": "ceekay-munshot/CGChecklist"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Caches MUNS model runs keyed by ticker/country so a run produced within the
  // last month is served from KV instead of re-running the model.
  // Create the namespace once and paste its id below:
  //   npx wrangler kv namespace create MUNS_RUNS
  "kv_namespaces": [
    {
      "binding": "MUNS_RUNS",
      "id": "9044ac1b534e49ebb1d36ccfd40895bd"
    }
  ],
  // Self-reference binding: lets a request fan its checklist lanes out into
  // separate Worker invocations (each with its own subrequest budget) from the
  // server side, so a run no longer depends on the browser to orchestrate it.
  // The coordinator (src/lib/munsCoordinator.ts) calls env.WORKER_SELF_REFERENCE
  // for each lane; without it, lanes fall back to running in-process (dev only).
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cgchecklist"
    }
  ],
  "build": {
    "command": "npx opennextjs-cloudflare build"
  },
  "observability": {
    "enabled": true
  }
}
