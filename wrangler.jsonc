{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cgchecklist",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "build": {
    "command": "npx opennextjs-cloudflare build"
  },
  "observability": {
    "enabled": true
  },
  // KV namespace backing the async routine-verification loop. The dashboard
  // writes a pending record on /api/verify/start, the routine callback fills it
  // in on /api/verify/callback, and the browser reads it via /api/verify/result.
  "kv_namespaces": [
    { "binding": "VERIFY_KV", "id": "4c87f1ed28f2402aaec4fa22a92bb1fd" }
  ]
}
